# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used when DB_DRIVER=pg).
DATABASE_URL=postgres://user:password@localhost:5432/better_dash

# Backend driver: 'pg' (PostgreSQL, default) or 'sqlite' (zero-setup dev / Turso prod).
DB_DRIVER=sqlite

# Path to local SQLite file for development (starts with file:).
SQLITE_DB_PATH=file:./src/db/sqlite/admin-panel.db

# Turso Cloud credentials for production (when DB_DRIVER=sqlite)
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of this admin panel (used for passkey rpID, reset links, …).
BETTER_AUTH_BASE_URL=http://localhost:8080

# Base path for auth endpoints (the /v1/api catch-all forwards here).
BETTER_AUTH_BASE_PATH=v1/api

# Comma-separated list of origins allowed to call auth endpoints
# (main app, mobile dev server, panel dev server, …).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# Comma-separated CORS allow-list for the /v1/api/* endpoints.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# Absolute URL the server uses for in-process API calls (SSR). In production
# this is the deployed origin, e.g. https://admin.example.com.
APP_URL=http://localhost:8080

# Display name shown in the browser tab / document title, e.g. "Acme Admin".
# Rendered as "<Page> · <APP_NAME>" per route. Defaults to "Admin Panel".
VITE_APP_NAME=Admin Panel

# Comma-separated IPs/CIDRs of reverse proxies allowed to set client IP
# headers (x-forwarded-for etc.). Leave empty when not behind a proxy — the
# socket address is used then, which cannot be spoofed.
TRUSTED_PROXIES=

# ─── Optional: Better Auth Infrastructure (dash + sentinel) ──────────────────
# Get a key at https://better-auth.com (account → API keys). When empty, the
# dash analytics and sentinel abuse-protection plugins are disabled.
BETTER_AUTH_API_KEY=

# ─── E2E tests (optional) ────────────────────────────────────────────────────
# Used by the Playwright global setup to provision the test admin account.
E2E_ADMIN_EMAIL=admin.e2e@example.com
E2E_ADMIN_PASSWORD=password123
